# Copy this file to .env and adjust as needed.
# The app reads these via os.getenv() with sensible defaults if unset.

WIKI_LANGUAGE=en
WIKIBOT_USER_AGENT=IntelligentWikipediaResearchBot/1.0 (you@example.com)
WIKIBOT_TIMEOUT=10
WIKIBOT_MAX_RETRIES=3
WIKIBOT_RETRY_BACKOFF=1.5
WIKIBOT_MAX_QUERY_LENGTH=300
WIKIBOT_SEARCH_LIMIT=10
WIKIBOT_DATA_DIR=data
WIKIBOT_DB_PATH=data/research.db
WIKIBOT_LOG_LEVEL=INFO
WIKIBOT_LOG_FILE=data/wikibot.log

# Set this for PostgreSQL after updating src/database.py.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# RAG / LLM. Neon AI Gateway also works with these names:
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
RAG_MAX_SOURCES=5
RAG_MAX_CONTEXT_CHARS=12000
# Free local embeddings. The model downloads once and runs locally.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Optional remote provider alternative:
# EMBEDDING_API_KEY=your_embedding_provider_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
